#!/bin/bash
# vantage-bind-key - bind (or unbind) a physical key to launch Vantage.
set -euo pipefail

BINDINGS_FILE="$HOME/.config/hypr/bindings.lua"
MARK_BEGIN="-- vantage-bind-key: begin (re-run vantage-bind-key to change this)"
MARK_END="-- vantage-bind-key: end"
KDE_DESKTOP="$HOME/.local/share/applications/vantage-key.desktop"
KDE_SHORTCUT_GROUP="vantage-key.desktop"

usage() {
    echo "Usage: vantage-bind-key [--unbind]" >&2
    exit 1
}

unbind_only=0
case "${1:-}" in
    "") ;;
    --unbind) unbind_only=1 ;;
    *) usage ;;
esac

[ "$(id -u)" -ne 0 ] || { echo "Run this as your normal desktop user, not root." >&2; exit 1; }

bind_kde() {
    command -v kwriteconfig6 >/dev/null 2>&1 || { echo "kwriteconfig6 is required (install KDE CLI tools)." >&2; exit 1; }
    if [ "$unbind_only" -eq 1 ]; then
        kwriteconfig6 --file kglobalshortcutsrc --group "$KDE_SHORTCUT_GROUP" --key _launch "none,none,Launch Lenovo Vantage"
        rm -f "$KDE_DESKTOP"
        command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
        systemctl --user restart plasma-kglobalaccel.service 2>/dev/null || true
        echo "Removed the Lenovo Vantage global shortcut."
        return
    fi

    echo "A small key viewer will open. Focus it and press the Lenovo Vantage/Smart key (15 seconds)."
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        command -v wev >/dev/null 2>&1 || { echo "wev is required to capture the key. Install it with: sudo pacman -S wev" >&2; exit 1; }
        line=$(timeout 15 wev -f wl_keyboard:key 2>/dev/null | grep -m1 'state: 1 (pressed)' || true)
        sym=$(grep -oP '(?<=sym: )\S+' <<<"$line" || true)
    else
        command -v xev >/dev/null 2>&1 || { echo "xev is required to capture the key. Install it with: sudo pacman -S xorg-xev" >&2; exit 1; }
        line=$(timeout 15 xev -event keyboard 2>/dev/null | awk '/KeyPress event/ { waiting = 1; next } waiting && /keycode .*keysym/ { print; exit }' || true)
        sym=$(sed -n 's/.*keysym [^,]*, \([^)]*\)).*/\1/p' <<<"$line")
    fi
    [ -n "$line" ] || { echo "No key press detected. Try again." >&2; exit 1; }
    [ -n "$sym" ] && [ "$sym" != "NoSymbol" ] || { echo "The key has no keyboard symbol KDE can bind." >&2; exit 1; }

    mkdir -p "$(dirname "$KDE_DESKTOP")"
    cat > "$KDE_DESKTOP" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Launch Lenovo Vantage
Exec=/usr/bin/vantage
Icon=vantage
NoDisplay=true
StartupNotify=false
X-KDE-GlobalAccel-CommandShortcut=true
DESKTOP
    kwriteconfig6 --file kglobalshortcutsrc --group "$KDE_SHORTCUT_GROUP" --key _k_friendly_name "Launch Lenovo Vantage"
    kwriteconfig6 --file kglobalshortcutsrc --group "$KDE_SHORTCUT_GROUP" --key _launch "$sym,none,Launch Lenovo Vantage"
    command -v kbuildsycoca6 >/dev/null 2>&1 && kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    systemctl --user restart plasma-kglobalaccel.service 2>/dev/null || {
        echo "Saved $sym, but KDE could not reload shortcuts automatically. Log out and back in to activate it." >&2
        return 1
    }
    echo "Bound $sym to launch Lenovo Vantage in KDE Plasma."
}

if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]] || [[ "${XDG_CURRENT_DESKTOP:-}" == *kde* ]]; then
    bind_kde
    exit $?
fi

[ -f "$BINDINGS_FILE" ] || { echo "No Hyprland bindings file at $BINDINGS_FILE." >&2; exit 1; }

remove_existing_binding() {
    if grep -qF "$MARK_BEGIN" "$BINDINGS_FILE"; then
        sed -i "/$MARK_BEGIN/,/$MARK_END/d" "$BINDINGS_FILE"
    fi
}

if [ "$unbind_only" -eq 1 ]; then
    remove_existing_binding
    hyprctl reload >/dev/null 2>&1 || true
    echo "Removed the Vantage key binding."
    exit 0
fi

[ -n "${WAYLAND_DISPLAY:-}" ] || { echo "No Wayland session detected - run this from inside Hyprland." >&2; exit 1; }
command -v wev >/dev/null 2>&1 || { echo "wev is required to detect the key. Install it with: sudo pacman -S --needed wev" >&2; exit 1; }

echo "A tiny window will pop up. Click into it, then press the key you want to launch Vantage"
echo "(e.g. the dedicated Lenovo Vantage/Smart key). Waiting up to 15 seconds..."

line=$(timeout 15 wev -f wl_keyboard:key 2>/dev/null | grep -m1 'state: 1 (pressed)' || true)

if [ -z "$line" ]; then
    echo "No key press detected. Try again, or edit $BINDINGS_FILE by hand." >&2
    exit 1
fi

sym=$(grep -oP '(?<=sym: )\S+' <<<"$line" || true)
code=$(grep -oP '(?<=; key: )[0-9]+(?=;)' <<<"$line" || true)

if [ -n "$sym" ] && [ "$sym" != "NoSymbol" ]; then
    key_expr="$sym"
elif [ -n "$code" ]; then
    key_expr="code:$code"
else
    echo "Couldn't read a usable key from that press." >&2
    exit 1
fi

remove_existing_binding
{
    echo ""
    echo "$MARK_BEGIN"
    echo "o.bind(\"$key_expr\", \"Lenovo Vantage\", { launch = \"vantage\" })"
    echo "$MARK_END"
} >> "$BINDINGS_FILE"

hyprctl reload >/dev/null 2>&1 || true
echo "Bound $key_expr to launch Vantage."
